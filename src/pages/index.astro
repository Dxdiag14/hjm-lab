---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getProjects } from "../lib/wp";

const projects = await getProjects();
const featured = projects.filter((p) => p.kind === "public" && p.image).slice(0, 3);
const total = projects.length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "HJM Lab",
  url: "https://lab.hjmiranda.com/",
  description: "HJ Miranda's portfolio rebuilt as headless WordPress with an Astro front end.",
  author: { "@type": "Person", name: "HJ Miranda", url: "https://hjmiranda.com/" }
};
---
<Base
  title="HJM Lab – Headless WordPress + Astro | HJ Miranda"
  description="My WordPress portfolio rebuilt as a static Astro site. WordPress is still the CMS; Astro builds the pages. A side-by-side test of speed, weight and editing."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <span class="badge rise">Headless WordPress + Astro</span>
      <h1 class="display rise">Same portfolio. <span class="accent">A different stack.</span></h1>
      <p class="lead rise">
        This is my WordPress portfolio rebuilt with Astro. I still write and edit everything in WordPress.
        Astro reads it through the REST API and turns it into plain HTML when the site is built, so
        there's no PHP and no page builder running when you visit.
      </p>
      <div class="btns rise">
        <a class="btn" href="/work/">View the work <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--outline" href="/how-its-built/">How it’s built</a>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">01 — The experiment</span>
          <h2 class="h2">One set of content, two front ends</h2>
        </div>
        <p class="muted" style="max-width:420px">Both sites show the same {total} projects from the same WordPress database. Only the way the pages are made is different.</p>
      </div>

      <div class="compare">
        <div class="compare__col">
          <span class="eyebrow">hjmiranda.com</span>
          <h3 class="h3">WordPress + Elementor</h3>
          <dl>
            <div><dt>Pages are made</dt><dd>By PHP on the server, then cached by LiteSpeed</dd></div>
            <div><dt>Layout</dt><dd>Elementor containers and widgets</dd></div>
            <div><dt>Editing</dt><dd>Visual, drag and drop</dd></div>
            <div><dt>Hosting</dt><dd>PHP hosting with a database</dd></div>
          </dl>
        </div>
        <div class="compare__col">
          <span class="eyebrow">lab.hjmiranda.com</span>
          <h3 class="h3">WordPress (headless) + Astro</h3>
          <dl>
            <div><dt>Pages are made</dt><dd>Once, at build time, as static HTML</dd></div>
            <div><dt>Layout</dt><dd>Astro components and plain CSS</dd></div>
            <div><dt>Editing</dt><dd>Fields in WordPress, design in code</dd></div>
            <div><dt>Hosting</dt><dd>Static files on a CDN</dd></div>
          </dl>
        </div>
      </div>

      <p style="margin-top:28px"><a class="text-link" href="/how-its-built/">See the full comparison and results <span class="ne" aria-hidden="true">↗</span></a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">02 — Selected work</span>
          <h2 class="h2">Sites I’ve built and shipped</h2>
        </div>
        <a class="btn btn--outline" href="/work/">All {total} projects <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</Base>
